# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# hoopsai: local data store, model training cache and logs (outputs in lib/model + data/ ARE committed)
/.data/
/scripts/cache/
/scripts/train-log.txt

# generated by next dev, carries generator-authored em dashes
/AGENTS.md
.vercel
.env*
